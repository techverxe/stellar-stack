# Template only. NO real values belong in this file or anywhere in the repo
# (see the project's PLACEHOLDER_ discipline in src/content/business.ts).
#
# Installed once, by hand, to /etc/booking.env on the droplet,
# owned root:booking, mode 640. setup-server.sh creates it from
# this template if it does not already exist, but never overwrites a real one.
#
# The service runs fine with the Google/Resend lines blank: calendar.mjs and
# email.mjs treat missing credentials as "not configured yet" and no-op with
# a logged warning rather than failing the booking itself.

BOOKING_PORT=4001
BOOKING_DB_PATH=/var/lib/booking/bookings.db
SITE_BASE_URL=https://example-client.com

# Google Calendar via a SERVICE ACCOUNT, chosen over a user OAuth client.
# Create one in Google Cloud Console (IAM & Admin -> Service Accounts),
# download its JSON key, then base64-encode the WHOLE file to one line
# (e.g. `base64 < key.json | tr -d '\n'`) and paste the result below.
# Then share the target Google Calendar with the service account's email.
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=
GOOGLE_CALENDAR_ID=

# Resend (email notification).
# RESEND_API_KEY: create one scoped to this client.
# EMAIL_FROM: defaults to Resend's shared domain or client's domain.
RESEND_API_KEY=
EMAIL_FROM=Example Client <onboarding@resend.dev>
OWNER_NOTIFY_EMAIL=
